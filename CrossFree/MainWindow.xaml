<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crosshair" Width="980" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="{StaticResource Text}">
  <Window.Resources>
    <DataTemplate x:Key="PresetTpl">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Ellipse Width="10" Height="10" Fill="{Binding Color}" Margin="0,0,12,0" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Sub}" Foreground="{StaticResource Muted}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="CUSTOM" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="6,0,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Border Margin="12" CornerRadius="14" Background="{StaticResource Bg}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
    <Grid x:Name="Stage">

      <!-- Tło użytkownika: ostre + rozmyte (widoczne pod panelami) -->
      <Border x:Name="BgSharp" CornerRadius="13" Visibility="Collapsed" IsHitTestVisible="False"/>
      <Border x:Name="BgBlur" CornerRadius="13" Visibility="Collapsed" IsHitTestVisible="False"/>

      <!-- Zawartość -->
      <Grid x:Name="ContentRoot">
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition/></Grid.RowDefinitions>

        <!-- Pasek tytułu -->
        <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown" Margin="20,0,12,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="20" Height="20">
              <Path Data="M11,0 V8 M11,14 V22 M0,11 H8 M14,11 H22" Stroke="{StaticResource Accent}" StrokeThickness="2.2" Width="22" Height="22"/>
            </Viewbox>
            <TextBlock Text="CROSSHAIR" FontWeight="Bold" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <CheckBox x:Name="ChkOverlay" Style="{StaticResource Switch}" Content="Celownik" Click="Overlay_Click" Margin="0,0,18,0"/>
            <Button Style="{StaticResource WinBtn}" Content="&#xE921;" ToolTip="Minimalizuj" Click="Minimize_Click"/>
            <Button Style="{StaticResource WinBtn}" Content="&#xE706;" ToolTip="Wygaś do zasobnika (celownik dalej działa)" Click="Dim_Click"/>
            <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;" ToolTip="Zamknij program" Click="Close_Click"/>
          </StackPanel>
        </Grid>

        <!-- Treść -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
          <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>

          <!-- Sidebar -->
          <Grid>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <DockPanel x:Name="PanelMine">
                <TextBlock DockPanel.Dock="Top" Text="MOJE CELOWNIKI" Style="{StaticResource Lbl}" FontWeight="SemiBold" Margin="2,0,0,4"/>
                <TextBlock DockPanel.Dock="Bottom" Text="Własne ustawienia zapiszesz przyciskiem „Zapisz jako custom”." TextWrapping="Wrap" Style="{StaticResource Lbl}" FontSize="10.5" Margin="2,4,0,0"/>
                <ListBox x:Name="ListMine" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Preset}"
                         ItemTemplate="{StaticResource PresetTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="List_SelectionChanged">
                  <ListBox.GroupStyle>
                    <GroupStyle>
                      <GroupStyle.HeaderTemplate>
                        <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Lbl}" FontSize="10" FontWeight="SemiBold" Margin="2,8,0,8"/></DataTemplate>
                      </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                  </ListBox.GroupStyle>
                </ListBox>
              </DockPanel>

              <DockPanel x:Name="PanelGame" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" Text="GAME" Style="{StaticResource Lbl}" FontWeight="SemiBold" Margin="2,0,0,10"/>
                <WrapPanel DockPanel.Dock="Top" x:Name="CatPanel" Margin="0,0,0,6">
                  <RadioButton Style="{StaticResource ChipSm}" GroupName="cat" Content="CS2" Tag="CS2" IsChecked="True" Checked="Cat_Checked"/>
                  <RadioButton Style="{StaticResource ChipSm}" GroupName="cat" Content="Valorant" Tag="Valorant" Checked="Cat_Checked"/>
                  <RadioButton Style="{StaticResource ChipSm}" GroupName="cat" Content="Fortnite" Tag="Fortnite" Checked="Cat_Checked"/>
                  <RadioButton Style="{StaticResource ChipSm}" GroupName="cat" Content="FiveM" Tag="FiveM" Checked="Cat_Checked"/>
                  <RadioButton Style="{StaticResource ChipSm}" GroupName="cat" Content="Inne" Tag="Inne" Checked="Cat_Checked"/>
                </WrapPanel>
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Style="{StaticResource Lbl}" FontSize="10.5" Margin="2,4,0,0"
                           Text="Presety wzorowane na popularnych ustawieniach graczy. Kolor możesz zmienić. Sprawdź regulamin gry lub serwera – niektóre zabraniają nakładek."/>
                <ListBox x:Name="ListGame" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Preset}"
                         ItemTemplate="{StaticResource PresetTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="List_SelectionChanged"/>
              </DockPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,10,0,0">
              <Button x:Name="BtnGame" Style="{StaticResource SideBtnAccent}" Content="GAME   ›" Click="Game_Click"/>
              <Button Style="{StaticResource SideBtn}" Click="Settings_Click" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Ustawienia" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <!-- Podgląd + edytor -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="190"/><RowDefinition Height="14"/><RowDefinition/></Grid.RowDefinitions>

            <Border CornerRadius="12" BorderBrush="{StaticResource Edge}" BorderThickness="1" ClipToBounds="True">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#2A3447" Offset="0"/><GradientStop Color="#141A26" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Rectangle Fill="Black" Opacity="{Binding Value, ElementName=BgS}"/>
                <Canvas x:Name="Preview" SizeChanged="Preview_SizeChanged"/>
                <TextBlock Text="PODGLĄD" Style="{StaticResource Lbl}" FontSize="10" FontWeight="SemiBold" Margin="14,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <TextBlock x:Name="Toast" Opacity="0" Foreground="{StaticResource Accent}" FontSize="12" Margin="14,0,0,10" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
              </Grid>
            </Border>

            <Border Grid.Row="2" CornerRadius="12" Background="{StaticResource Card}" Padding="20,16">
              <StackPanel>
                <StackPanel Orientation="Horizontal" x:Name="ShapePanel" Margin="0,0,0,14">
                  <RadioButton Style="{StaticResource Chip}" GroupName="shape" Content="Cross"   Tag="Cross"   Checked="Shape_Checked"/>
                  <RadioButton Style="{StaticResource Chip}" GroupName="shape" Content="Dot"     Tag="Dot"     Checked="Shape_Checked"/>
                  <RadioButton Style="{StaticResource Chip}" GroupName="shape" Content="Circle"  Tag="Circle"  Checked="Shape_Checked"/>
                  <RadioButton Style="{StaticResource Chip}" GroupName="shape" Content="Diamond" Tag="Diamond" Checked="Shape_Checked"/>
                  <RadioButton Style="{StaticResource Chip}" GroupName="shape" Content="Sniper"  Tag="Sniper"  Checked="Shape_Checked"/>
                </StackPanel>

                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <Grid Height="26"><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource Lbl}" Text="Rozmiar"/>
                      <Slider x:Name="SizeS" Grid.Column="1" Style="{StaticResource Sld}" Minimum="4" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
                      <TextBlock Grid.Column="2" Style="{StaticResource Val}" Text="{Binding Value, ElementName=SizeS, StringFormat=0}"/></Grid>
                    <Grid Height="26"><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource Lbl}" Text="Grubość"/>
                      <Slider x:Name="ThickS" Grid.Column="1" Style="{StaticResource Sld}" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
                      <TextBlock Grid.Column="2" Style="{StaticResource Val}" Text="{Binding Value, ElementName=ThickS, StringFormat=0}"/></Grid>
                    <Grid Height="26"><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource Lbl}" Text="Przerwa"/>
                      <Slider x:Name="GapS" Grid.Column="1" Style="{StaticResource Sld}" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
                      <TextBlock Grid.Column="2" Style="{StaticResource Val}" Text="{Binding Value, ElementName=GapS, StringFormat=0}"/></Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Grid Height="26"><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource Lbl}" Text="Offset X"/>
                      <Slider x:Name="OxS" Grid.Column="1" Style="{StaticResource Sld}" Minimum="-100" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
                      <TextBlock Grid.Column="2" Style="{StaticResource Val}" Text="{Binding Value, ElementName=OxS, StringFormat=0}"/></Grid>
                    <Grid Height="26"><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource Lbl}" Text="Offset Y"/>
                      <Slider x:Name="OyS" Grid.Column="1" Style="{StaticResource Sld}" Minimum="-100" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
                      <TextBlock Grid.Column="2" Style="{StaticResource Val}" Text="{Binding Value, ElementName=OyS, StringFormat=0}"/></Grid>
                    <Grid Height="26"><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource Lbl}" Text="Tło podglądu"/>
                      <Slider x:Name="BgS" Grid.Column="1" Style="{StaticResource Sld}" Minimum="0" Maximum="1" ValueChanged="Bg_Changed"/>
                      <TextBlock Grid.Column="2" Style="{StaticResource Val}" Text="{Binding Value, ElementName=BgS, StringFormat=P0}"/></Grid>
                  </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <CheckBox x:Name="SwOutline" Style="{StaticResource Switch}" Content="Obrys" Click="Switch_Click" Margin="0,0,26,0"/>
                  <CheckBox x:Name="SwGlow" Style="{StaticResource Switch}" Content="Poświata" Click="Switch_Click" Margin="0,0,26,0"/>
                  <CheckBox x:Name="SwDot" Style="{StaticResource Switch}" Content="Kropka w środku" Click="Switch_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Ellipse x:Name="ColorDot" Width="18" Height="18" Margin="0,0,10,0"/>
                  <TextBox x:Name="TxtColor" Style="{StaticResource Tb}" Width="96" MaxLength="9" TextChanged="TxtColor_TextChanged" Margin="0,0,14,0"/>
                  <Button Style="{StaticResource Swatch}" Background="#FFFFFF" Tag="#FFFFFF" Click="Swatch_Click"/>
                  <Button Style="{StaticResource Swatch}" Background="#00E5FF" Tag="#00E5FF" Click="Swatch_Click"/>
                  <Button Style="{StaticResource Swatch}" Background="#00FF66" Tag="#00FF66" Click="Swatch_Click"/>
                  <Button Style="{StaticResource Swatch}" Background="#FFD700" Tag="#FFD700" Click="Swatch_Click"/>
                  <Button Style="{StaticResource Swatch}" Background="#FF5E8E" Tag="#FF5E8E" Click="Swatch_Click"/>
                  <Button Style="{StaticResource Swatch}" Background="#A288FF" Tag="#A288FF" Click="Swatch_Click"/>
                  <Button Style="{StaticResource Swatch}" Background="#FF3B30" Tag="#FF3B30" Click="Swatch_Click"/>
                  <Button Style="{StaticResource Swatch}" Background="#FF9F0A" Tag="#FF9F0A" Click="Swatch_Click"/>
                </StackPanel>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="TxtName" Style="{StaticResource Tb}" MaxLength="24" Margin="0,0,12,0"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnPrimary}" Content="Zapisz jako custom" Click="Save_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnOver" Style="{StaticResource Btn}" Content="Nadpisz" Click="Overwrite_Click" Margin="0,0,8,0"
                            ToolTip="Nadpisuje zaznaczony własny celownik (zapis jako custom zawsze tworzy nowy)"/>
                    <Button Style="{StaticResource Btn}" Content="Reset" Click="Reset_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnDel" Style="{StaticResource Btn}" Content="Usuń" Click="Delete_Click"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <!-- Ustawienia -->
      <Border x:Name="SettingsLayer" Visibility="Collapsed" CornerRadius="13" Background="#B3080A0E">
        <Border Width="460" CornerRadius="16" Background="#F2151821" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                Padding="26,22" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border.RenderTransform><TranslateTransform x:Name="SetTr"/></Border.RenderTransform>
          <StackPanel>
            <Grid Margin="0,0,0,18">
              <TextBlock Text="Ustawienia" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
              <Button Style="{StaticResource WinBtn}" Content="&#xE8BB;" HorizontalAlignment="Right" Click="SettingsClose_Click"/>
            </Grid>

            <TextBlock Text="TŁO APLIKACJI" Style="{StaticResource Lbl}" FontWeight="SemiBold" FontSize="10.5" Margin="0,0,0,8"/>
            <Border CornerRadius="9" Background="{StaticResource Card2}" Padding="12,9" Margin="0,0,0,10">
              <TextBlock x:Name="BgNameTxt" Text="Brak własnego tła" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <Button Style="{StaticResource BtnPrimary}" Content="Wybierz obraz…" Click="PickBg_Click" Margin="0,0,8,0"/>
              <Button Style="{StaticResource Btn}" Content="Usuń tło" Click="RemoveBg_Click"/>
            </StackPanel>

            <Grid Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Lbl}" Text="Krycie tła"/>
              <Slider x:Name="BgImgS" Grid.Column="1" Style="{StaticResource Sld}" Minimum="0" Maximum="1" ValueChanged="BgImg_Changed"/>
              <TextBlock Grid.Column="2" Style="{StaticResource Val}" Text="{Binding Value, ElementName=BgImgS, StringFormat=P0}"/></Grid>
            <Grid Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Lbl}" Text="Rozmycie paneli"/>
              <Slider x:Name="BlurS" Grid.Column="1" Style="{StaticResource Sld}" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Blur_Changed"/>
              <TextBlock Grid.Column="2" Style="{StaticResource Val}" Text="{Binding Value, ElementName=BlurS, StringFormat=0}"/></Grid>
            <TextBlock Style="{StaticResource Lbl}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Panele działają jak matowe szkło: tło pod nimi jest rozmyte, więc przyciski i suwaki zawsze zostają czytelne."/>

            <Border Height="1" Background="{StaticResource Edge}" Margin="0,18,0,16"/>

            <TextBlock Text="SAMOUCZEK" Style="{StaticResource Lbl}" FontWeight="SemiBold" FontSize="10.5" Margin="0,0,0,8"/>
            <Button Style="{StaticResource Btn}" Content="Pokaż samouczek ponownie" HorizontalAlignment="Left" Click="TutorialAgain_Click"/>

            <Grid Margin="0,8,0,0">
              <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource Muted}">
                <Run Text="Made by "/><Run Text="raqso" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
              </TextBlock>
              <Button Style="{StaticResource BtnPrimary}" Content="Gotowe" HorizontalAlignment="Right" Click="SettingsClose_Click"/>
            </Grid>
          </StackPanel>
        </Border>
      </Border>

      <!-- Powitanie / samouczek (tylko przy pierwszym uruchomieniu) -->
      <Border x:Name="Tutorial" Visibility="Collapsed" CornerRadius="13" Background="#E60A0C10">
        <Border Width="480" CornerRadius="18" Background="#FF151821" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                Padding="34,30" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border.RenderTransform><TranslateTransform x:Name="TutTr"/></Border.RenderTransform>
          <StackPanel>
            <Viewbox Width="36" Height="36" HorizontalAlignment="Left">
              <Path Data="M11,0 V8 M11,14 V22 M0,11 H8 M14,11 H22" Stroke="{StaticResource Accent}" StrokeThickness="2.2" Width="22" Height="22"/>
            </Viewbox>
            <TextBlock x:Name="TutStep" Style="{StaticResource Lbl}" FontSize="10.5" FontWeight="SemiBold" Margin="0,20,0,0"/>
            <TextBlock x:Name="TutTitle" FontSize="24" FontWeight="Bold" Margin="0,4,0,12" TextWrapping="Wrap"/>
            <TextBlock x:Name="TutBody" Foreground="#B4BACB" FontSize="13.5" LineHeight="21" TextWrapping="Wrap" MinHeight="105"/>
            <StackPanel x:Name="TutDots" Orientation="Horizontal" Margin="0,18,0,20"/>
            <Grid>
              <Button x:Name="TutSkip" Style="{StaticResource Btn}" Background="Transparent" Foreground="{StaticResource Muted}"
                      Content="Pomiń samouczek" HorizontalAlignment="Left" Padding="0,0,16,0" Click="TutSkip_Click"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TutBack" Style="{StaticResource Btn}" Content="Wstecz" Margin="0,0,8,0" Click="TutBack_Click"/>
                <Button x:Name="TutNext" Style="{StaticResource BtnPrimary}" Content="Dalej" Click="TutNext_Click"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Border>

    </Grid>
  </Border>
</Window>
